#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  phoenix-rebuild [--print] [--branch NAME | --worktree PATH] [--task TASK] [--reason PURPOSE] <action> [nixos-rebuild args...]
  phoenix-<action> [--print] [--branch NAME | --worktree PATH] [--task TASK] [--reason PURPOSE] [nixos-rebuild args...]

Test/switch/boot run nixos-rebuild --sudo with its terminal authentication/output.
Optional --reason/--task are accepted for compatibility, not broker audit context.
Agents must use ai-broker for authenticated immutable deployment and reservations.
All actions forward nixos-rebuild arguments.
Runs the selected workflow against the auto-selected PhoeNix OS flake target.
Set PHOENIX_TARGET=vm or PHOENIX_TARGET=metal to override detection.
EOF
}

print_only=false
selector=()
reason_supplied=false
authorization_context=false
reservation_file=""
action=""
if [ "$#" -eq 0 ]; then usage; exit 0; fi
# Consume only dispatcher options at the front. Once the rebuild option tail
# starts, preserve it exactly (including values resembling source selectors).
while [ "$#" -gt 0 ]; do
  case "$1" in
    --print) print_only=true; shift ;;
    --authorization-context)
      if [ "$authorization_context" = true ]; then exit 2; fi
      authorization_context=true; shift ;;
    --reservation-file)
      if [ -n "$reservation_file" ] || [ "$#" -lt 2 ] || [ -z "$2" ]; then exit 2; fi
      reservation_file="$2"; shift 2 ;;
    --task)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then exit 2; fi
      shift 2 ;;
    --reason)
      if [ "$reason_supplied" = true ] || [ "$#" -lt 2 ]; then
        printf 'phoenix-rebuild: supply one --reason with a value\n' >&2; exit 2
      fi
      reason_supplied=true; shift 2 ;;
    --branch|--worktree)
      if [ "${#selector[@]}" -ne 0 ] || [ "$#" -lt 2 ] || [ -z "$2" ]; then
        printf 'phoenix-rebuild: supply one --branch or --worktree with a value\n' >&2
        exit 2
      fi
      selector=("$1" "$2"); shift 2 ;;
    -h|--help)
      if [ -n "$action" ]; then break; fi
      usage; exit 0 ;;
    *)
      if [ -n "$action" ]; then break; fi
      action="$1"; shift ;;
  esac
done

case "$action" in
  switch|test|boot|build|dry-build)
    ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    printf 'phoenix-rebuild: unsupported action: %s\n' "$action" >&2
    usage >&2
    exit 2
    ;;
esac

repo_root="${PHOENIX_REPO_ROOT:-}"
if [ -z "$repo_root" ] || [ ! -f "$repo_root/flake.nix" ]; then
  printf 'phoenix-rebuild: configured Phoenix checkout is unavailable: %s\n' "${repo_root:-<unset>}" >&2
  printf 'Set PHOENIX_REPO_ROOT or update repoDirectory in config/user.nix.\n' >&2
  exit 127
fi

if [ "${#selector[@]}" -gt 0 ]; then
  repo_root="$(phoenix-source --repo "$repo_root" "${selector[@]}")"
fi

target="$(phoenix-target)"

flake_ref="${repo_root}#${target}"

# These human-facing commands retain nixos-rebuild's terminal authentication/UI.
# Agent deployment is a separate immutable ai-broker mapping, never an env mode.
if [ "$authorization_context" = true ] || [ -n "$reservation_file" ]; then
  printf 'phoenix-rebuild: authorization context/reservations require ai-broker deployment\n' >&2; exit 2
fi
cmd=(nixos-rebuild)

case "$action" in
  switch|test|boot)
    cmd+=(--sudo)
    ;;
esac

cmd+=("$action" --flake "$flake_ref" "$@")

print_command() {
  local arg
  for arg in "$@"; do
    printf '%q ' "$arg"
  done
  printf '\n'
}

if [ "$print_only" = true ]; then
  print_command "${cmd[@]}"
  exit 0
fi

case "$action" in
  build|dry-build)
    work_dir="${TMPDIR:-/tmp}/phoenix-rebuild"
    mkdir -p "$work_dir"
    cd "$work_dir"
    ;;
esac

exec "${cmd[@]}"
