#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  phoenix-target [--info|--source|--require TARGET]

Prints the selected PhoeNix OS flake target.

Selects metal/metal-4tb by stable root filesystem UUID, or vm in a VM.
Unknown metal roots, conflicting PHOENIX_TARGET and stale installed targets fail.
--require checks the target expected by an updater or deployment controller.
EOF
}

mode="target"
expected=""

case "${1:-}" in
  "")
    ;;
  --info)
    mode="info"
    ;;
  --source)
    mode="source"
    ;;
  --require)
    [ "$#" -eq 2 ] || { printf 'phoenix-target: --require needs one target\n' >&2; exit 2; }
    expected="$2"
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    printf 'phoenix-target: unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

root_uuid="$("${phoenix_root_probe:-findmnt}" --noheadings --raw --output UUID --target /)" || {
  printf 'phoenix-target: cannot identify root filesystem; refusing selection\n' >&2; exit 2;
}
case "$root_uuid" in
  e9d1b391-3f86-4254-9970-aa47df230474) target="metal" ;;
  b1756a78-0da5-47a3-a73c-38112d1ac945) target="metal-4tb" ;;
  *)
    if systemd-detect-virt --quiet --vm; then
      target="vm"
    else
      printf 'phoenix-target: unknown root filesystem UUID; refusing selection\n' >&2; exit 2
    fi ;;
esac
source="root-filesystem:$root_uuid"
[ "$target" != vm ] || source="systemd-detect-virt"
for declared in "${PHOENIX_TARGET:-}" "${phoenix_configured_target:-}" "$expected"; do
  if [ -n "$declared" ] && [ "$declared" != "$target" ]; then
    printf 'phoenix-target: requested/installed target %s conflicts with root target %s\n' "$declared" "$target" >&2
    exit 2
  fi
done

case "$mode" in
  target)
    printf '%s\n' "$target"
    ;;
  source)
    printf '%s\n' "$source"
    ;;
  info)
    printf 'target=%s source=%s\n' "$target" "$source"
    ;;
esac
