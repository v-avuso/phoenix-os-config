set -euo pipefail

session="${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}"

# Hyprland
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] \
  || [[ "$session" == *Hyprland* ]] \
  || [[ "$session" == *hyprland* ]]; then
  # Match Caelestia's tested graceful logout and SDDM greeter VT handoff.
  # Dispatch inside Hyprland so shutdown is owned by the compositor session.
  phoenix_hyprshutdown="${phoenix_hyprshutdown:-$(command -v hyprshutdown)}"
  exec hyprctl dispatch "hl.dsp.exec_cmd('${phoenix_hyprshutdown} --vt 1')"
fi

# KDE Plasma
if [[ "$session" == *KDE* ]] \
  || [[ "$session" == *plasma* ]] \
  || [[ "$session" == *plasmax11* ]]; then
  exec qdbus org.kde.Shutdown /Shutdown logout
fi

echo "No supported logout command found for this session." >&2
echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}" >&2
echo "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-}" >&2
echo "HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}" >&2
exit 1
