+        // Called under the connection lock after request authentication. Preserve
+        // idempotent explicit retries, but never replace recovery-loss ownership.
+        // true means termination already completed, regardless of its cause.
+        fn begin_supervisor_termination(&mut self) -> Result<bool, &'static str> {
+            match *self {
+                Self::Terminal(_) => Ok(true),
+                Self::Terminating(TerminationCause::RecoveryExpired) => {
+                    Err("boundary is terminating after supervisor recovery expired")
+                }
+                Self::AwaitingConfirmation => Err("boundary has no confirmed supervisor"),
+                Self::Connected(_)
+                | Self::Frozen { .. }
+                | Self::Terminating(TerminationCause::SupervisorRequest) => {
+                    *self = Self::Terminating(TerminationCause::SupervisorRequest);
+                    Ok(false)
+                }
+            }
+        }
+
+        fn complete_termination(&mut self, cause: TerminationCause) -> bool {
+            if *self == Self::Terminating(cause) {
+                *self = Self::Terminal(cause);
+            }
+            *self == Self::Terminal(cause)
+        }
