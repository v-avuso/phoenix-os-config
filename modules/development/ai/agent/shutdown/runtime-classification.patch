+        #[test]
+        fn termination_signal_classification_preserves_cause() {
+            use SupervisorConnectionState as State;
+            use TerminationCause::{RecoveryExpired, SupervisorRequest};
+            for (state, confirmed) in [
+                (State::AwaitingConfirmation, false),
+                (State::Connected(SandboxConnectionId::new()), true),
+                (State::Frozen { recovery_id: 7 }, false),
+                (State::Terminating(SupervisorRequest), false),
+                (State::Terminating(RecoveryExpired), false),
+                (State::Terminal(SupervisorRequest), true),
+                (State::Terminal(RecoveryExpired), false),
+            ] {
+                assert_eq!(state.confirmed_for_termination(), confirmed, "{state:?}");
+            }
+        }
+
+        #[test]
+        fn termination_ownership_recovery_first_cannot_be_reclassified() {
+            use SupervisorConnectionState as State;
+            use TerminationCause::{RecoveryExpired, SupervisorRequest};
+            let mut state = State::Frozen { recovery_id: 7 };
+            // Exact transition used by expiry, paused before its process await.
+            assert!(state.begin_recovery_termination(7));
+            assert!(state.begin_supervisor_termination().is_err());
+            assert!(!state.complete_termination(SupervisorRequest));
+            assert_eq!(state, State::Terminating(RecoveryExpired));
+            assert!(state.complete_termination(RecoveryExpired));
+            assert_eq!(state.begin_supervisor_termination(), Ok(true));
+            assert_eq!(state, State::Terminal(RecoveryExpired));
+            assert!(!state.confirmed_for_termination());
+        }
+
+        #[test]
+        fn termination_ownership_explicit_first_preserves_in_progress_retries() {
+            use SupervisorConnectionState as State;
+            use TerminationCause::{RecoveryExpired, SupervisorRequest};
+            let mut state = State::Frozen { recovery_id: 7 };
+            // An already-authenticated request may win before expiry claims loss;
+            // new frozen-session requests still fail existing authorization.
+            assert_eq!(state.begin_supervisor_termination(), Ok(false));
+            assert!(!state.begin_recovery_termination(7));
+            assert_eq!(state.begin_supervisor_termination(), Ok(false));
+            assert!(!state.complete_termination(RecoveryExpired));
+            assert!(!state.confirmed_for_termination());
+            // Incomplete cleanup leaves the same retryable state, not success.
+            assert_eq!(state, State::Terminating(SupervisorRequest));
+            assert!(state.complete_termination(SupervisorRequest));
+            assert_eq!(state.begin_supervisor_termination(), Ok(true));
+            assert!(state.confirmed_for_termination());
+        }
