+    } // A controlled RPC future exercises the production drain/ownership code;
+    // actual tonic/server acknowledgement remains an isolated VM criterion.
+    fn controlled_rpc() -> (
+        mpsc::Sender<PushSandboxLogsRequest>,
+        OwnedRpc,
+        tokio::sync::oneshot::Receiver<Vec<Vec<String>>>,
+        tokio::sync::oneshot::Sender<Result<(), tonic::Code>>,
+        tokio::sync::oneshot::Receiver<()>,
+    ) {
+        let (tx, mut rx) = mpsc::channel::<PushSandboxLogsRequest>(2);
+        let (seen_tx, seen) = tokio::sync::oneshot::channel();
+        let (ack, ack_rx) = tokio::sync::oneshot::channel();
+        let (dropped, cleanup) = tokio::sync::oneshot::channel();
+        struct Cleanup(Option<tokio::sync::oneshot::Sender<()>>);
+        impl Drop for Cleanup {
+            fn drop(&mut self) {
+                if let Some(tx) = self.0.take() {
+                    let _ = tx.send(());
+                }
+            }
+        }
+        let guard = Cleanup(Some(dropped));
+        let rpc = OwnedRpc(tokio::spawn(async move {
+            let _guard = guard;
+            let mut batches = Vec::new();
+            while let Some(request) = rx.recv().await {
+                batches.push(request.logs.into_iter().map(|line| line.message).collect());
+            }
+            let _ = seen_tx.send(batches); // EOF observed, response still withheld.
+            ack_rx.await.unwrap_or(Err(tonic::Code::Cancelled))
+        }));
+        (tx, rpc, seen, ack, cleanup)
+    }
