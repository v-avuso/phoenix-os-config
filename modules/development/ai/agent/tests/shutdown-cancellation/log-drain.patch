+        use std::sync::atomic::Ordering;
+        let (tx, _rx) = mpsc::channel(1);
+        let layer = LogPushLayer::new("sb-test".to_string(), tx);
+        let stats = layer.stats.clone();
+        tracing::subscriber::with_default(tracing_subscriber::registry().with(layer), || {
+            tracing::info!("accepted");
+            tracing::info!("dropped-full");
+        });
+        assert_eq!(stats.dropped.load(Ordering::Relaxed), 1);
+        stats.uncertain.store(true, Ordering::Relaxed);
+        let (stop, _stopping) = tokio::sync::watch::channel(None);
+        let owner = LogPushHandle {
