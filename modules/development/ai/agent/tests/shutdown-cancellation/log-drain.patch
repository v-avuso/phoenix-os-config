+                    .await
+                    .is_err()
+            );
+            stop.send_replace(Some(
+                tokio::time::Instant::now() + tokio::time::Duration::from_secs(1),
+            ));
+            assert_eq!(send.await, Ok(true));
+        }
+        assert_eq!(batch.len(), 100);
+    }
