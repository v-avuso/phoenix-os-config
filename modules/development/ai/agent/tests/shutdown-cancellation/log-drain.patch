+/// Outcome describes the retained accepted tail, never all historical logs.
+#[derive(Debug)]
+pub struct LogPushOutcome {
+    pub accepted_tail_acknowledged: bool,
+    pub local_dropped_lines: u64,
+    pub prior_stream_delivery_uncertain: bool,
+    pub incomplete: Option<PushFailure>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PushFailure {
+    NotConnected,
+    RpcError,
+    Authentication,
+    Timeout,
+    WorkerEnded,
+}
+
+#[derive(Default)]
+struct PushStats {
+    dropped: std::sync::atomic::AtomicU64,
+    uncertain: std::sync::atomic::AtomicBool,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum PushResult {
+    Acknowledged,
+    Incomplete(PushFailure),
+}
+
+/// The worker owns every streaming call; cancellation/drop aborts it as well.
+struct OwnedRpc(tokio::task::JoinHandle<Result<(), tonic::Code>>);
+impl Drop for OwnedRpc {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+pub struct LogPushHandle {
+    stop: tokio::sync::watch::Sender<Option<tokio::time::Instant>>,
+    worker: tokio::task::JoinHandle<PushResult>,
+    stats: std::sync::Arc<PushStats>,
+}
+impl Drop for LogPushHandle {
+    fn drop(&mut self) {
+        self.worker.abort();
+    }
+}
+impl LogPushHandle {
+    pub async fn shutdown(mut self) -> LogPushOutcome {
+        use std::sync::atomic::Ordering;
+        let deadline = tokio::time::Instant::now() + tokio::time::Duration::from_secs(1);
+        self.stop.send_replace(Some(deadline));
+        let result = match tokio::time::timeout_at(deadline, &mut self.worker).await {
+            Ok(Ok(result)) => result,
+            Ok(Err(_)) => PushResult::Incomplete(PushFailure::WorkerEnded),
+            Err(_) => PushResult::Incomplete(PushFailure::Timeout),
+        };
+        LogPushOutcome {
+            accepted_tail_acknowledged: result == PushResult::Acknowledged,
+            local_dropped_lines: self.stats.dropped.load(Ordering::Relaxed),
+            prior_stream_delivery_uncertain: self.stats.uncertain.load(Ordering::Relaxed),
+            incomplete: match result {
+                PushResult::Acknowledged => None,
+                PushResult::Incomplete(reason) => Some(reason),
+            },
+        }
+    }
+}
+
+pub fn spawn_log_push_task(endpoint: String, sandbox_id: String) -> (LogPushLayer, LogPushHandle) {
+    let (tx, rx) = mpsc::channel(1024);
+    let stats = std::sync::Arc::new(PushStats::default());
+    let (stop, stopping) = tokio::sync::watch::channel(None);
+    let worker = tokio::spawn(run_push_loop(
+        endpoint,
+        sandbox_id.clone(),
+        rx,
+        stopping,
+        stats.clone(),
+    ));
+    let mut layer = LogPushLayer::new(sandbox_id, tx);
+    layer.stats = stats.clone();
+    (
+        layer,
+        LogPushHandle {
+            stop,
+            worker,
+            stats,
+        },
+    )
+}
