+        let worker = tokio::spawn(async move {
+            let _rpc = rpc;
+            let _ = ready_tx.send(());
+            std::future::pending::<PushResult>().await
+        });
+        let (stop, _stopping) = tokio::sync::watch::channel(None);
+        let owner = LogPushHandle {
