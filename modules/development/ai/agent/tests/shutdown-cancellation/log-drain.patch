+const BATCH_LINES: usize = 50;
+
+async fn send_batches(
+    sandbox_id: &str,
+    batch: &mut Vec<SandboxLogLine>,
+    tx: &mpsc::Sender<PushSandboxLogsRequest>,
+) -> Result<(), ()> {
+    // The server takes at most100 lines/request. Reconnect can retain200;
+    // chunk that buffer too instead of receiving a misleading partial ack.
+    while !batch.is_empty() {
+        let permit = tx.reserve().await.map_err(|_| ())?;
+        let count = batch.len().min(BATCH_LINES);
+        permit.send(PushSandboxLogsRequest {
+            sandbox_id: sandbox_id.to_string(),
+            logs: batch.drain(..count).collect(),
+        });
+    }
+    Ok(())
+}
+
+// true means shutdown interrupted a live send. Reserve before taking lines so
+// interruption preserves the accepted batch for the final bounded drain.
+async fn send_or_stop(
+    sandbox_id: &str,
+    batch: &mut Vec<SandboxLogLine>,
+    tx: &mpsc::Sender<PushSandboxLogsRequest>,
+    stopping: &mut tokio::sync::watch::Receiver<Option<tokio::time::Instant>>,
+) -> Result<bool, ()> {
+    tokio::select! {
+        biased;
+        _ = stopping.changed() => Ok(true),
+        result = send_batches(sandbox_id, batch, tx) => result.map(|()| false),
+    }
+}
+
+async fn finish_push(
+    sandbox_id: &str,
+    rx: &mut mpsc::Receiver<SandboxLogLine>,
+    batch: &mut Vec<SandboxLogLine>,
+    push_tx: mpsc::Sender<PushSandboxLogsRequest>,
+    mut rpc: OwnedRpc,
+    deadline: tokio::time::Instant,
+) -> PushResult {
+    // Receiver closure is authoritative even while the global subscriber keeps
+    // sender clones alive. It rejects new lines but preserves accepted queue data.
+    rx.close();
+    let finish = async {
+        while let Some(line) = rx.recv().await {
+            batch.push(line);
+            if batch.len() >= BATCH_LINES
+                && send_batches(sandbox_id, batch, &push_tx).await.is_err()
+            {
+                return PushResult::Incomplete(PushFailure::RpcError);
+            }
+        }
+        if send_batches(sandbox_id, batch, &push_tx).await.is_err() {
+            return PushResult::Incomplete(PushFailure::RpcError);
+        }
+        drop(push_tx); // EOF must precede the server's final unary response.
+        match (&mut rpc.0).await {
+            Ok(Ok(())) => PushResult::Acknowledged,
+            Ok(Err(tonic::Code::Unauthenticated)) => {
+                PushResult::Incomplete(PushFailure::Authentication)
+            }
+            _ => PushResult::Incomplete(PushFailure::RpcError),
+        }
+    };
+    tokio::time::timeout_at(deadline, finish)
+        .await
+        .unwrap_or(PushResult::Incomplete(PushFailure::Timeout))
+}
 
