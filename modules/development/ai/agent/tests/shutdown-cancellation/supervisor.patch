+/// Tracks an owned SSH delivery task, independent of remote channel closure.
+pub struct TerminalDeliveryTask(watch::Sender<usize>);
+impl Drop for TerminalDeliveryTask {
+    fn drop(&mut self) {
+        self.0.send_modify(|count| *count -= 1);
+    }
+}
 
