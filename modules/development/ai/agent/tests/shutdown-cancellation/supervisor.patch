+    #[tokio::test]
+    async fn terminal_delivery_admission_registers_before_cancel_drain() {
+        let session = MainSession::inert();
+        // Pause the admitted handler before it can set up or spawn its writer.
+        let admitted = session.begin_terminal_attachment().expect("admit handler");
+        assert_eq!(
+            *session.delivery_tasks.borrow(),
+            1,
+            "admission must register its owned writer before returning"
+        );
+        session.cancel_terminal_delivery();
+        assert!(session.begin_terminal_attachment().is_err());
+        let drain = session.wait_for_terminal_delivery_tasks();
+        tokio::pin!(drain);
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), &mut drain)
+                .await
+                .is_err()
+        );
+        // Handler cancellation before spawn drops exactly the admitted ownership.
+        drop(admitted);
+        tokio::time::timeout(std::time::Duration::from_secs(1), drain)
+            .await
+            .unwrap();
+        session.end_terminal_attachment();
+    }
