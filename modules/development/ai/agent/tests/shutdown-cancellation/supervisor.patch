+    /// Cancel delivery without fabricating gateway acknowledgement.
+    pub async fn cancel_main_terminal_delivery(&self) {
+        if let Some(main_session) = self.main_session.as_ref() {
+            main_session.cancel_terminal_delivery();
+            // Bound only the already-cancelled owned writers; never wait for
+            // a future attachment or remote channel-close acknowledgement.
+            // Accepted SSH connections are detached from the listener; this
+            // budget does not prove their termination. Process-runtime teardown
+            // remains the final fallback for a blocked connection/writer.
+            if tokio::time::timeout(
+                Duration::from_secs(1),
+                main_session.wait_for_terminal_delivery_tasks(),
+            )
+            .await
+            .is_err()
+            {
+                tracing::warn!("administrative terminal delivery cleanup budget exhausted");
+            }
+        }
     }
 
